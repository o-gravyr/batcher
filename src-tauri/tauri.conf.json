{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gravyr Batcher",
  "version": "1.0.1",
  "identifier": "fr.gravyr.batcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run vite:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gravyr Batcher",
        "width": 1180,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Batch text + logo overlay on images",
    "longDescription": "Drop a CSV or XLSX of localized texts and a folder of images. Gravyr Batcher renders each image with the localized text and the brand logo, exporting one folder per row in 1:1 and 9:16 formats.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {},
      "nsis": {}
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBNTlGMUQyMzRGMjE3NQpSV1IxSVU4akhaK2xBb25pbk1xVUc1MVFVMi9Jck12ZFJxSERzcjlkcHUvRXZYTVJVY0grTmF0bQo=",
      "endpoints": [
        "https://github.com/o-gravyr/batcher/releases/latest/download/latest.json"
      ]
    }
  }
}
